# environment variables for the project

# NextAuth
# Generate your own secret key for JWT encryption, typing command : `openssl rand -base64 32`
AUTH_SECRET=your-secret-key                     # ex: AUTH_SECRET=dkH0v9E+YN8WnPAqLGa4EEyuwyTvpSrXnVPeOrH25Dc=
# AUTH_URL=http://localhost:3000                 # Set this to the exact app origin used in Google OAuth (e.g. https://your-domain.com)

# Prisma
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="SUBSTITUTE_SUPABASE_ANON_KEY"     # ex: DATABASE_URL="postgresql://username:password@ep-super-unit-1.eu-central-1.aws.neon.tech/database?sslmode=require"

# SendGrid
# to send emails (or if you want to develop magic link for authentication)
AUTH_SENDGRID_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth
# Have look at https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-Oauth2.0             # ex: AUTH_GOOGLE_ID=567651309970-23rp816jgpjmi8lfpft2qs8cq706gqkq.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-secret                  # ex: AUTH_GOOGLE_SECRET=JUCSPX-l_QYVXoPxr0pLVDEyNB4n3XzxAN9
# Google OAuth authorized redirect URI must include:
# http://localhost:3000/api/auth/callback/google
# and, in production, https://your-domain.com/api/auth/callback/google

NEXT_BASE_URL=http://localhost:3000               # origin used for return URLs

# ─── POLAR (merchant of record) ────────────────────────────────────────────
# Polar is the legal seller: it handles VAT/sales tax and pays out through
# Stripe Connect Express, which covers Argentina (a direct Stripe account does
# not). Sandbox and production are separate instances — tokens and product IDs
# from one do NOT exist in the other.
#
# Sandbox dashboard:    https://sandbox.polar.sh
# Production dashboard: https://polar.sh
POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxxxxxxxxx
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox                             # 'production' when going live

# Product IDs (UUIDs) of the recurring monthly products created in Polar.
# The amounts must match lib/plans.ts or the landing page will advertise a
# price different from what the customer is charged.
NEXT_PUBLIC_POLAR_STARTER_PRODUCT_ID=            # Starter — $15/mo
NEXT_PUBLIC_POLAR_PRO_PRODUCT_ID=                # Pro — $29/mo

# The customer portal is opened server-side via /api/payment/portal.

# Stripe was retired because it does not support payouts to Argentina.
# The full implementation is kept in legacy/stripe/ — see its README to revive it.

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=                             # ex: NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-123456789

# email settings with Mailgun
# have a look at https://app.eu.mailgun.com/settings/api_security
MAILGUN_API_KEY=xxxx-xx-xx                    # ex : MAILGUN_API_KEY=48f648fd4229189885ca000000000000-00e4a3d5-883e27xx
# Region of your Mailgun account: https://api.mailgun.net (US) or https://api.eu.mailgun.net (EU)
MAILGUN_BASE_URL=https://api.mailgun.net
# Verified sending domain. Falls back to MAILGUN_SANDBOX_DOMAIN, which can only
# mail addresses added as "Authorized Recipients" in the Mailgun dashboard.
MAILGUN_DOMAIN=                               # ex: mail.momentreel.com
MAILGUN_SANDBOX_DOMAIN=                       # ex: sandboxxxxx.mailgun.org
# Inbox that receives the in-app feedback form
FEEDBACK_EMAIL=

# Google Tag Manager
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=                           # ex: NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXX

# admin user id for impersonate security
NEXT_PUBLIC_ADMIN_USER_ID=your-user-id

# AI Services - Vercel AI SDK
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Anthropic for Claude (future provider flexibility)
# Get your API key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Video Storage
# Option 1: Supabase Storage (recommended for existing stack)
# Get credentials from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Option 2: AWS S3 (alternative)
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=momentreel-videos

# Video Processing Limits
MAX_VIDEO_SIZE_MB=500                               # Maximum upload size in MB
MAX_VIDEO_DURATION_SECONDS=3600                     # Maximum video duration (1 hour)
MAX_CLIPS_PER_VIDEO=10                              # Maximum clips to generate per video

# Background Queue (BullMQ)
# Local: redis://localhost:6379
# Production: use Upstash Redis (https://upstash.com) — compatible with BullMQ
REDIS_URL=redis://localhost:6379

# Audio chunking for long videos (seconds per chunk sent to Whisper)
AUDIO_CHUNK_DURATION=300                            # 5 minutes per chunk (default)

# Subscription Bypass for Development
# Comma-separated list of emails that bypass subscription checks
# Example: SUBSCRIPTION_BYPASS_EMAILS=dev@example.com,admin@example.com
SUBSCRIPTION_BYPASS_EMAILS=