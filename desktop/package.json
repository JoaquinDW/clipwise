{
  "name": "momentreel-desktop",
  "productName": "Momentreel",
  "version": "0.1.0",
  "private": true,
  "description": "Turn long videos into vertical shorts on your own computer, driven by your own AI agent over MCP.",
  "author": "Momentreel",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "dev:engine": "node build.mjs && node dist/serve.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "dist:mac": "node build.mjs && electron-builder --mac",
    "dist:win": "node build.mjs && electron-builder --win"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.0.13",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "electron-updater": "^6.8.11",
    "fluent-ffmpeg": "^2.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.134",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.5.2",
    "vitest": "^5.0.5"
  }
}
