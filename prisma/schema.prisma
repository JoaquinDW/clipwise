// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[] 
  company       Company?   @relation(fields: [companyId], references: [id])
  companyId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model Company {
  id          String    @id @default(cuid())
  name        String
  users       User[]    @relation
  transactions PaymentTransaction[]
  videos      Video[]

  // Billing / subscription state, kept in sync from the provider's webhook.
  // Deliberately provider-neutral: Polar and Stripe share the same status
  // vocabulary, so switching providers is config, not a migration.
  billingProvider       String?   // polar | stripe
  billingCustomerId     String?   @unique
  billingSubscriptionId String?   @unique
  billingProductId      String?
  plan                  String?   // starter | pro
  subscriptionStatus    String?   // trialing | active | past_due | canceled | incomplete | unpaid | paused
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime?

  minutesUsed    Float     @default(0) // Track video processing minutes
  minutesResetAt DateTime? // Start of the current metering period

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())
}
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}

model PaymentTransaction {
  id            String    @id @default(cuid())
  company       Company   @relation(fields: [companyId], references: [id])
  companyId     String
  raw           Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @default(now())
}

enum VideoSource {
  UPLOAD
  YOUTUBE
  TWITCH
  KICK
}

enum VideoStatus {
  UPLOADING
  UPLOADED
  INGESTING
  INGESTED
  TRANSCRIBING
  TRANSCRIBED
  SCORING
  RANKING
  PROCESSING
  READY
  FAILED
}

enum ClipStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum JobType {
  TRANSCRIBE
  DETECT_HIGHLIGHTS
  GENERATE_CLIPS
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Video {
  id            String        @id @default(cuid())
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  title         String
  description   String?
  source        VideoSource   @default(UPLOAD)
  sourceUrl     String?       // YouTube URL or original upload URL
  storageUrl    String?       // URL in storage (Supabase/S3)
  audioUrl      String?       // URL of extracted audio (Supabase)
  thumbnailUrl  String?
  duration      Int?          // Duration in seconds
  minutesMetered Boolean      @default(false) // Guard so a retry never double-bills
  status        VideoStatus   @default(UPLOADING)
  errorMessage  String?
  metadata         Json?         // Additional video metadata
  analysisMetrics  Json?         // { fullTranscriptTokenEstimate, actualTokenEstimate, compressionRatio, candidateCount, durationMs }
  transcription    Transcription?
  clips            Clip[]
  candidates       Candidate[]
  jobs             ProcessingJob[]
  audioChunks      AudioChunk[]
  createdAt        DateTime      @default(now())
  updatedAt     DateTime      @updatedAt @default(now())

  @@index([companyId, status])
  @@index([createdAt])
}

model Transcription {
  id          String   @id @default(cuid())
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId     String   @unique
  text        String   @db.Text // Full transcription text
  language    String?  // Detected language
  segments    Json     // Array of {start, end, text} from Whisper
  words       Json?    // Array of {word, start, end} for word-level timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([videoId])
}

model Clip {
  id            String      @id @default(cuid())
  video         Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId       String
  title         String
  description   String?     @db.Text
  startTime     Float       // Start time in seconds
  endTime       Float       // End time in seconds
  duration      Float       // Clip duration in seconds
  storageUrl    String?     // URL of processed clip
  thumbnailUrl  String?
  captions      Json?       // Generated captions with timestamps
  score         Float?      // AI-generated virality score
  status        ClipStatus  @default(PENDING)
  errorMessage  String?
  metadata      Json?       // Hook text, highlights, etc.
  parentClipId  String?     // Set on user-edited copies; null = original AI clip
  originalStart Float?      // startTime of parent clip, for ±15s validation
  originalEnd   Float?      // endTime of parent clip, for ±15s validation
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt @default(now())

  @@index([videoId, status])
  @@index([createdAt])
}

model ProcessingJob {
  id            String      @id @default(cuid())
  video         Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId       String
  type          JobType
  status        JobStatus   @default(PENDING)
  progress      Int         @default(0) // 0-100
  errorMessage  String?     @db.Text
  result        Json?       // Job result data
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt @default(now())

  @@index([videoId, type])
  @@index([status])
}

model AudioChunk {
  id          String   @id @default(cuid())
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId     String
  index       Int
  startTime   Float
  endTime     Float
  storageUrl  String?
  transcript  Json?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([videoId, status])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Candidate {
  id             String   @id @default(cuid())
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId        String
  startTime      Float
  endTime        Float
  expandedStart  Float
  expandedEnd    Float
  transcript     String   @db.Text
  heuristicScore Float
  gptScore       Float?
  finalScore     Float?
  rank           Int?
  createdAt      DateTime @default(now())

  @@index([videoId, heuristicScore])
}